#!/usr/bin/env sh
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
archive="$project_root/internal/runtimebundle/assets/runtime.tar.gz"
dist="$project_root/dist"
cd "$project_root"

cleanup() {
	[ ! -e "$archive" ] || unlink "$archive"
}
trap cleanup EXIT

mkdir -p "$dist"
"$project_root/scripts/go" run ./cmd/lisan-runtime-pack "$project_root" "$archive"

build() {
	goos=$1
	goarch=$2
	extension=$3
	output="$dist/lisan_${goos}_${goarch}${extension}"
	printf 'Building %s/%s -> %s\n' "$goos" "$goarch" "$output"
	CGO_ENABLED=0 GOOS=$goos GOARCH=$goarch \
		"$project_root/scripts/go" build -trimpath -buildvcs=false -ldflags='-s -w -buildid=' -o "$output" ./cmd/lisan
}

build linux amd64 ""
build linux arm64 ""
build darwin amd64 ""
build darwin arm64 ""
build windows amd64 .exe
build windows arm64 .exe

(
	cd "$dist"
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum lisan_* > SHA256SUMS
	else
		shasum -a 256 lisan_* > SHA256SUMS
	fi
)

printf 'Release binaries and checksums are in %s\n' "$dist"
