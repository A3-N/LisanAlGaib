#!/bin/sh
set -eu

template=/usr/local/share/lisan/home
nvim_template=/usr/local/share/lisan/nvim

mkdir -p \
  /home/fremen/agents \
  /home/fremen/projects

seed_file() {
  relative_path=$1
  if [ ! -e "/home/fremen/$relative_path" ]; then
    cp "$template/$relative_path" "/home/fremen/$relative_path"
  fi
}

/usr/local/bin/lisan-seed-agent-assets "$template/agents" /home/fremen/agents
if command -v fish >/dev/null 2>&1; then
  mkdir -p /home/fremen/.config/fish/conf.d
  seed_file .config/fish/config.fish
  # This is a Lisan-owned fragment, so image updates can improve the prompt
  # without replacing the user's main Fish configuration.
  cp "$template/.config/fish/conf.d/lisan-prompt.fish" /home/fremen/.config/fish/conf.d/lisan-prompt.fish
fi

# A named home volume masks files added by a later profile image. Seed NvChad
# when it becomes selected, but never replace an existing editor config.
if [ "${LISAN_NVCHAD:-0}" = 1 ] && [ ! -e /home/fremen/.config/nvim ]; then
  mkdir -p /home/fremen/.config/nvim
  cp -a "$nvim_template/." /home/fremen/.config/nvim/
fi

# Migrate Lisan's NvChad additions inside existing persistent home volumes.
# Dashboards without Lisan's fb action are deliberately left untouched.
lisan_chadrc=/home/fremen/.config/nvim/lua/chadrc.lua
lisan_nvchad_sync=0
if command -v nvim >/dev/null 2>&1 && [ -f "$lisan_chadrc" ] && grep -Eq 'keys = "fb".*(NvimTree(Open|Focus)|lisan\.picker)' "$lisan_chadrc"; then
  mkdir -p /home/fremen/.config/nvim/lua/lisan /home/fremen/.config/nvim/lua/plugins

  if [ ! -f /home/fremen/.config/nvim/lua/lisan/picker.lua ] || \
    ! cmp -s "$nvim_template/lua/lisan/picker.lua" /home/fremen/.config/nvim/lua/lisan/picker.lua; then
    cp "$nvim_template/lua/lisan/picker.lua" /home/fremen/.config/nvim/lua/lisan/picker.lua
  fi
  if [ ! -f /home/fremen/.config/nvim/lua/plugins/lisan-file-browser.lua ] || \
    ! cmp -s "$nvim_template/lua/plugins/lisan-file-browser.lua" /home/fremen/.config/nvim/lua/plugins/lisan-file-browser.lua; then
    cp "$nvim_template/lua/plugins/lisan-file-browser.lua" /home/fremen/.config/nvim/lua/plugins/lisan-file-browser.lua
    lisan_nvchad_sync=1
  fi
  if [ ! -f /home/fremen/.config/nvim/lua/plugins/lisan-cursor.lua ] || \
    ! cmp -s "$nvim_template/lua/plugins/lisan-cursor.lua" /home/fremen/.config/nvim/lua/plugins/lisan-cursor.lua; then
    cp "$nvim_template/lua/plugins/lisan-cursor.lua" /home/fremen/.config/nvim/lua/plugins/lisan-cursor.lua
    lisan_nvchad_sync=1
  fi

  cp "$nvim_template/lua/lisan/header.lua" /home/fremen/.config/nvim/lua/lisan/header.lua

  if ! grep -q 'lisan.header' "$lisan_chadrc"; then
    sed -i '/M.nvdash = {/a\  header = function() return require("lisan.header").lines() end,' "$lisan_chadrc"
  fi

  sed -i \
    -e "/keys = \"fb\"/c\\    { txt = function() return require(\"lisan.picker\").workspace_label() end, keys = \"fb\", cmd = \"lua require('lisan.picker').choose_workspace()\" }," \
    -e "/keys = \"ff\"/c\\    { txt = \"󰱼  Open File\", keys = \"ff\", cmd = \"lua require('lisan.picker').open_file()\" }," \
    "$lisan_chadrc"

  if ! grep -q 'keys = "fr"' "$lisan_chadrc"; then
    sed -i "/keys = \"ff\"/a\\    { txt = \"󰉋  Browse Filesystem\", keys = \"fr\", cmd = \"lua require('lisan.picker').browse_filesystem()\" }," "$lisan_chadrc"
  fi

  if [ ! -d /home/fremen/.local/share/nvim/lazy/telescope-file-browser.nvim ] || \
    [ ! -d /home/fremen/.local/share/nvim/lazy/SmoothCursor.nvim ] || \
    [ ! -d /home/fremen/.local/share/nvim/lazy/smear-cursor.nvim ]; then
    lisan_nvchad_sync=1
  fi
fi

if [ "$lisan_nvchad_sync" -eq 1 ]; then
  nvim --headless '+Lazy! install' +qa
fi

cd /home/fremen
exec "$@"
