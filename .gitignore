# Local toolchains, caches, and build outputs
/.toolchain/
/.cache/
/bin/
/build/
/dist/
/out/
/internal/runtimebundle/assets/runtime.tar.gz
/extensions/*/bin/
/shared/*
!/shared/.gitkeep

# Per-agent workspace configuration is copied into Docker locally but must not
# be committed. Keep only Lisan's non-secret instruction templates tracked.
/docker/home/agents/*/**
!/docker/home/agents/*/AGENTS.md
!/docker/home/agents/claude/CLAUDE.md
*.test
*.exe
*.prof
*.coverprofile
*.tmp

# Common extension/tool caches stay local even when contributors use other
# languages inside a bundle.
**/node_modules/
**/target/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
.idea/
.vscode/

# Runtime and editor state
*.log
.DS_Store
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.netrc
.npmrc
.pypirc
credentials.json
*.har
*.pcap
*.pcapng
*.swp
coverage.out
